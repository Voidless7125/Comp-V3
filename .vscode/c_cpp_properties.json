{
    "env": {
        "vex_compilerPath": "${config:vexrobotics.vexcode.Cpp.Toolchain.Path}\\clang\\bin\\clang.exe",
        "vex_sdkPath": "${config:vexrobotics.vexcode.Cpp.Sdk.Home}\\V5\\V5_20240802_15_00_00\\vexv5",
        "vex_gcc": "${vex_sdkPath}/gcc/include/c++/15.3.1",
        "vex_sdkIncludes": [
            "${vex_sdkPath}/clang/23/include",
            "${vex_sdkPath}/clang/23/include/**",
            "${vex_gcc}",
            "${vex_gcc}/**",
            "${vex_gcc}/arm-none-eabi/thumb/v7-a+fp/softfp",
            "${vex_gcc}/arm-none-eabi/thumb/v7-a+fp/softfp/**",
            "${vex_sdkPath}/gcc/include",
            "${vex_sdkPath}/gcc/include/**",
            "${vex_sdkPath}/include",
            "${vex_sdkPath}/include/**",
            "${workspaceFolder}/include",
            "${workspaceFolder}/include/**",
            "${workspaceFolder}/src",
            "${workspaceFolder}/src/**"
        ]
    },
    "configurations": [
        {
            "name": "Win32",
            "includePath": [
                "${vex_sdkIncludes}"
            ],
            "defines": [
                "VexV5",
                "__arm__",
                "__ARM_ARCH_7A__"
            ],
            "compilerPath": "${vex_compilerPath}",
            "compilerArgs": [
                "-target",
                "thumbv7-none-eabi",
                "-march=armv7-a",
                "-mfpu=neon",
                "-mfloat-abi=softfp"
            ],
            "cStandard": "gnu23",
            "cppStandard": "gnu++23",
            "intelliSenseMode": "windows-clang-arm"
        }
    ],
    "version": 4
}